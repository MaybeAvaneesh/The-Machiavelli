+
 function getClient(): Mistral | null {
-  const key = process.env.MISTRAL_API_KEY;
+  const key = process.env.MISTRAL_API_KEY?.trim();
   if (!key) return null;
-  return new Mistral({ apiKey: key });
+  return new Mistral({
