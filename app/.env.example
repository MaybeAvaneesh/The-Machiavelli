# Narration providers, tried in this order. Any without a key is skipped.
NARRATION_PROVIDERS=groq,mistral

# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mistral (backup): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional: override API base URLs (e.g. for a proxy or local testing)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
